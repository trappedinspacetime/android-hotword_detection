<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Uyan Wake Word"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Durduruldu"
        android:textSize="20sp"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Başlat"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/batteryButton"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Batarya Optimizasyonunu Kapat"
        android:textSize="14sp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not: İlk kullanımda mikrofon izni verin.\nModel dosyası (uyan.onnx) assets klasöründe olmalıdır."
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="40dp" />

</LinearLayout>
